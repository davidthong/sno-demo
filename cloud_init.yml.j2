#cloud-config

# Enable SSH password authentication
ssh_pwauth: true

# ---------------------------------------------
# Write Network Configuration File (ifcfg-eth0)
# ---------------------------------------------
write_files:
  - path: /etc/sysconfig/network-scripts/ifcfg-eth0
    content: |
      # Static IP configuration (RHEL/CentOS style)
      IPADDR={{ ip_address }}
      PREFIX={{ ip_prefix }}
      GATEWAY={{ default_gateway }}
      DOMAIN={{ domain }}
      
      # Required settings for static configuration
      BOOTPROTO=none
      ONBOOT=yes
      DEVICE=eth0

# ---------------------------------------------
# User Configuration
# ---------------------------------------------
users:
  - name: {{ os_username }}
    # Set the password in plain text
    plain_text_passwd: {{ os_password }}
    # Conditional password locking (ansnix_lock_passwd must be defined)
    lock_passwd: {{ (true | lower) if ansnix_lock_passwd else (false | lower) }}

# ---------------------------------------------
# Execute Command on Final Boot
# ---------------------------------------------
runcmd:
  # Reload network settings to apply changes made above
  - nmcli connection reload
