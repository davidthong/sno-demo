{
  "api_version": "3.0",
  "metadata": {
    "kind": "vm"
  },
  "spec": {
    "name": "{{ vm_name }}",
    "description": "Created by Ansible",
    "cluster_reference": {
      "kind": "cluster",
      "uuid": "{{ cluster_uuid }}"
    },
    "resources": {
      "num_vcpus_per_socket": {{ vm_num_vcpus }},
      "num_sockets": 1,
      "memory_size_mib": {{ vm_memory_mib }},
      "nic_list": [
        {
          "subnet_reference": {
            "kind": "subnet",
            "uuid": "{{ network_uuid }}"
          }
        }
      ],
      "disk_list": [
        {
          "disk_size_mib": {{ vm_disk_size_mib }},
          "device_properties": {
            "disk_address": {
              "device_index": 0,
              "adapter_type": "SCSI"
            }
          }
        }
      ],
      "power_state": "ON"
    }
  }
}
